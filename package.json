{
  "name": "zenith-launcher",
  "productName": "Zenith",
  "version": "1.0.1",
  "description": "Zenith - a fast, beautiful game launcher for Windows.",
  "main": "out/main/index.js",
  "author": "Zenith",
  "license": "MIT",
  "repository": "github:nikitagriddy/zenith-launcher",
  "homepage": "https://github.com/nikitagriddy/zenith-launcher",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.12",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "37.10.3",
    "electron-builder": "26.0.20",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.52.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "vite": "^6.4.5",
    "zustand": "^5.0.3"
  }
}
